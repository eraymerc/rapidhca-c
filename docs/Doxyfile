# Project settings
PROJECT_NAME           = "rapidHCA-c"
PROJECT_BRIEF          = "C implementation and documentation"

# Tell Doxygen where your code lives
INPUT                  = src
RECURSIVE              = YES

# Optimize parsing for C source code
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES

# Output formats (We only want HTML for the website)
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# Enable the interactive sidebar
GENERATE_TREEVIEW      = YES

# Disable the old-school top navigation index
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

# Point to your new CSS files (paths are relative to the root directory)
HTML_EXTRA_STYLESHEET  = docs/doxygen-theme/doxygen-awesome.css \
                         docs/doxygen-theme/doxygen-awesome-sidebar-only.css

